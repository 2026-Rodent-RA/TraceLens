# =============================================================================
# TraceLens — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets (NEVER commit)
# -----------------------------------------------------------------------------
.env
.envrc
*.env.local

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/
*.mo
*.pot
local_settings.py
instance/
.webassets-cache
.scrapy
docs/_build/
.pybuilder/
target/
.ipynb_checkpoints
profile_default/
ipython_config.py
__pypackages__/
.pdm-python
.pdm-build/
.pixi
celerybeat-schedule
celerybeat.pid
*.rdb
*.aof
*.pid
*.sage.py
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.spyderproject
.spyproject
.ropeproject
/site
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
.ruff_cache/
.pypirc
.abstra/
tempCodeRunnerFile.py

# -----------------------------------------------------------------------------
# Node.js / Frontend / Hardhat
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build output
frontend/dist/
frontend/build/
frontend/.vite/

# TypeScript build info
*.tsbuildinfo

# Hardhat / Blockchain
blockchain/artifacts/
blockchain/cache/
blockchain/deployments/
blockchain/.openzeppelin/
blockchain/coverage/
blockchain/coverage.json
blockchain/typechain-types/

# -----------------------------------------------------------------------------
# SQLite / Storage
# -----------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
*.db

# Backend storage directory (runtime data, not code)
backend/data/

# -----------------------------------------------------------------------------
# ML / Dataset (raw data never committed)
# -----------------------------------------------------------------------------
ml/data/raw/
ml/data/processed/
ml/outputs/

# -----------------------------------------------------------------------------
# OS / Editor
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/