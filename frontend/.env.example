# frontend/.env.example
# Vercel 배포 시 아래 변수를 Vercel Dashboard → Environment Variables에 입력하세요
# (이 파일은 Git에 포함되며, 실제 값은 절대 이 파일에 직접 쓰지 마세요)

# Backend API URL
# Local 개발: 생략 가능 (기본값: http://localhost:8000)
# Vercel 배포 시: Render 백엔드 URL로 교체
VITE_API_BASE_URL=https://your-tracelens-backend.onrender.com
