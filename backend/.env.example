# Backend 환경변수 예시
# 실제 값을 .env 파일에 설정하세요 (.env는 Git에 포함되지 않습니다)

# AI 분석 데이터 소스 디렉토리
# 개발 초기: mock/ 디렉토리 사용
# AI 팀원 출력 완성 후: ml/outputs/ 로 변경
ANALYSIS_DATA_DIR=../mock

# Backend 서버 설정
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS 허용 Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Blockchain (PHASE 4 이후 설정)
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# CONTRACT_ADDRESS=
# DEPLOYER_PRIVATE_KEY=
