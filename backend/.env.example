# backend/.env.example
# 실제 값을 .env 파일에 설정하세요 (.env는 Git에 포함되지 않습니다)
# cp .env.example .env  →  .env 파일을 편집하세요

# =============================================================================
# AI 분석 데이터 소스
# =============================================================================
# ML 파이프라인이 생성한 백엔드 호환 사건 JSON
ANALYSIS_DATA_DIR=../demo/backend_cases

# =============================================================================
# Backend 서버 설정
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# =============================================================================
# CORS 허용 Origins
# =============================================================================
# Local 개발용 (기본값과 동일, 생략 가능)
# CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
#
# Render 배포 시 → Vercel 도메인으로 교체
# CORS_ORIGINS='["https://tracelens.vercel.app"]'

# =============================================================================
# Database
# =============================================================================
# Local 개발: SQLite (기본값, 아래 줄 생략 가능)
# DATABASE_URL=sqlite:///./data/tracelens.db
#
# Render 배포 시: Neon / Supabase PostgreSQL URL로 교체
# DATABASE_URL=postgresql://user:password@host.neon.tech/tracelens?sslmode=require

# =============================================================================
# Blockchain
# =============================================================================
# Local 개발: Hardhat 로컬 노드
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0xYourLocalContractAddress

# Render 배포 시: Alchemy Sepolia URL + 새 Wallet key로 교체
# BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# CONTRACT_ADDRESS=0xYourSepoliaContractAddress

# ISSUER_PRIVATE_KEY: Blockchain 트랜잭션 서명에 사용하는 Wallet Private Key
# ⚠️  절대로 실제 Mainnet 자금이 있는 key를 사용하지 마세요
# ⚠️  Render 환경변수에 직접 입력하고 이 파일에는 절대 실제 값을 쓰지 마세요
ISSUER_PRIVATE_KEY=your-issuer-wallet-private-key

